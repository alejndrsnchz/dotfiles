{
    "layer": "top",
    "position": "top",
    "height": 25,
    "modules-left": [
        "hyprland/workspaces",
    ],

    "modules-center": [
        "hyprland/window"
    ],

    "modules-right": [
        "tray",
        "pulseaudio#output",
        "pulseaudio#mic",
        "clock",
        "battery",
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "●",
            "default": "●"
        },
        "on-click": "activate",
        "active-only": false,
        "all-outputs": true
    },

    "hyprland/window": {
        "max-length": 50,
        "separate-outputs": true
    },

    "pulseaudio#output": {
        "format": "{volume}%",
        "format-muted": "Muted",
        "tooltip": false,
        "on-click": "pamixer --toggle-mute",
        "on-click-right": "pavucontrol -t 3"
    },

    "pulseaudio#mic": {
        "format": "{source_volume}%",
        "format-source-muted": "Muted",
        "tooltip": false,
        "on-click": "pamixer --default-source --toggle-mute",
        "on-click-right": "pavucontrol -t 4"
    },

    "clock": {
        "format": "{:%d %b  %H:%M}",
        "interval": 1,
        "tooltip": false
    },

    /*
    "battery": {
        "interval": 10,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}%",
        "format-charging": "{capacity}%+",
        "format-full": "100%"
    },
    */
    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "format-charging": "󰂄 {capacity}%",
        "states": {
            "warning": 30,
            "critical": 15
        }
    },

    "tray": {
        "icon-size": 10,
        "spacing": 6
    }
}
